#!/usr/bin/env python3
"""post-tool-use protocol script — non-blocking disk-hygiene reminder after a
full rust-crucible regression (`workspace-regression`, `pre-merge-gate`, or
`smoke-test --all-features`), which can leave 100-200G+ of target/ artifacts.

Normalized from the deployed ~/.claude/hooks/post-regression-disk-reminder.sh
baseline (CR-MDB-015 §S3): stdin contract on the neutral payload (CR-MDB-030 §S3: `tool_name` `bash` /
`tool_input.command`), same scope (the neutral `bash` class + the full-regression
rust-crucible commands only), same informational `{"reason": ...}` JSON on a
match. ALWAYS exit 0 (informational, never blocks). Self-contained, stdlib
only (no jq).
"""

import json
import re
import subprocess
import sys

_REGRESSION_PATTERNS = (
    re.compile(r"rust-crucible(\.py)?\s+(workspace-regression|pre-merge-gate)"),
    re.compile(r"rust-crucible(\.py)?\s+smoke-test(\s.*)?--all-features"),
)


def _disk_line() -> str:
    try:
        result = subprocess.run(
            ["df", "-h", "/home"], capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return "(df unavailable)"
    lines = result.stdout.strip().splitlines()
    return lines[-1] if lines else "(df unavailable)"


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return 0  # unreadable payload -> silent no-op (informational hook)
    if not isinstance(payload, dict) or payload.get("tool_name") != "bash":  # neutral shell class (schema.md)
        return 0
    command = (payload.get("tool_input") or {}).get("command") or ""
    if not command:
        return 0

    if any(pattern.search(command) for pattern in _REGRESSION_PATTERNS):
        reason = (
            "💽 DISK-HYGIENE (rust-orchestration.md — Disk hygiene): a full "
            "--all-features regression ran — it can leave 100-200G+ of target/ "
            f"artifacts. Disk now: {_disk_line()}. If free space is low, "
            "reclaim (orchestrator-only): `cargo sweep --time 7` + "
            "`cargo cache --autoclean`. Root-owned docker bind-mount leftovers "
            "(e.g. a worktree 'deploy/*.yaml' dir) need `sudo rm -rf`; if "
            "btrfs/snapper is pinning freed blocks, delete old snapshots "
            "(`sudo snapper -c home list`)."
        )
        print(json.dumps({"reason": reason}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
