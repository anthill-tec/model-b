#!/usr/bin/env python3
"""pre-tool-use protocol script — HARD-BLOCKS a direct `cargo test` /
`cargo nextest` / `cargo llvm-cov` (+ `check` / `clippy`, with or without a
`+toolchain`) run inside a Rust project and redirects it to the rust-crucible.py
client (CR-MDB-062 §S5).

Contract: the neutral payload (CR-MDB-030 §S3: `tool_name` `bash` /
`tool_input.command` / `cwd`); exit 0 allows, exit 2 blocks with
`{"decision":"block","reason":...}` on stdout. Self-contained and stdlib only
(CR-MDB-015): the detector is inlined, no sibling module is imported.

Command positions (CR-MDB-062 §S2): every line start outside quotes and
outside a heredoc body (`<<WORD`, `<<'WORD'`, `<<"WORD"`, `<<-WORD`), and the
text after `&&`, `||`, `;`, `|`, `&` or `(` outside quotes. Leading wrappers are
stepped over: `VAR=value`, `env` with its options and assignments, `timeout`
with its options and a duration, `nice [-n N]` and `time`. A runner is read in
the words the shell passes it: quotes removed, a redirection no part of them; a
here-string `<<<` opens no heredoc. A runner word inside a quoted argument or
a heredoc body is never a position, and a line break ends a command. It reads
shell as the raw-runner guard does (`tests/test_raw_runner_guard.py`).

Command positions also follow the shell grammar (CR-MDB-066 §S1): the reserved
words `!`, `{`, `if`, `then`, `else`, `elif`, `while`, `until` and `do`, each a
whole word before whitespace, are stepped over like a wrapper, in any order with
the others, and so are `command [-p]` (`command -v` / `-V` run nothing and stay
allowed) and `time [-p]`. An unquoted backquote opens a command substitution:
its text, up to the closing backquote, is one more position, and the enclosing
command still runs to its own end; a backquote in quotes or a heredoc body
opens nothing, and an unclosed one reads as an unclosed quote. An unquoted
`$((…))` or `((…))` is skipped whole, up to the `))` that brings its depth back
to zero: nothing in it is a position and no `<<` in it opens a heredoc.

Where it applies (CR-MDB-062 §S3): a `Cargo.toml` in the payload's `cwd`, in a
parent up to and including the git root (the nearest ancestor holding any `.git`
entry), or in a directory at most 3 levels below that git root. The walk below
follows no symlink, skips hidden directories, `node_modules`, `.venv`, `venv`,
`target`, `dist` and `build`, and stops at the first marker. Each directory is
listed once per run, with `os.scandir` (CR-MDB-066 §S4): that one listing serves
both its markers and its child directories, the deepest directory's for its
markers alone, and a listed marker counts only when `os.path.isfile` accepts it
(a directory or a symlink loop named like one does not). A directory that can be
searched but not listed is checked by name for its literal markers and its
`.git` entry, and is not descended. Without a git root only the `cwd` and its
parents count. An empty or missing `cwd`, an unreadable payload, a non-`bash`
tool, a command that does not tokenise and any filesystem error allow: this is a
deterrent, and an exception from a `closed` hook would block every shell call.

The block reason (CR-MDB-062 §S4) names the client listed in Crucible's
manifest `~/.crucible/crucible-clients.json` —
`~/.crucible/clients/rust-crucible.py`, installed by Crucible's own installer —
with its `test`, `check` and `workspace-regression` verbs, and the
`ALLOW_RAW_CARGO=1` escape hatch, used only with the orchestrator's approval.
"""

import json
import os
import re
import shlex
import sys
from pathlib import Path

#: The project marker of this hook's stack (CR-MDB-062 §S3).
MARKERS = ("Cargo.toml",)
#: How far below the git root the marker walk looks, and the directories it never enters.
WALK_DEPTH = 3
SKIPPED_DIRS = frozenset({"node_modules", ".venv", "venv", "target", "dist", "build"})

#: Where a runner command word ends.
_END = r"(?=$|[\s)\"'`,])"
#: A cargo run at a command position: an optional `+toolchain`, then a test-running verb
#: (`check` and `clippy` are this hook's extras beyond the guard's rows).
CARGO_RUN = re.compile(r"cargo(?:\s+\+\S+)?\s+(?:test|nextest|llvm-cov|check|clippy)" + _END)
#: A command separator outside quotes; a `&` in a redirection (`2>&1`, `&>file`) and the `|`
#: of `>|` separate nothing.
_SEPARATOR = re.compile(r"&&|\|\||\|&|;|(?<![<>])\|(?!\|)|(?<![<>])&(?![&>])|\(")
#: A heredoc operator; its body, from the next line to the line `WORD`, is never a position.
_HEREDOC = re.compile(r"<<(-?)[ \t]*(?:'([^'\n]*)'|\"([^\"\n]*)\"|\\?([A-Za-z0-9_][\w.-]*))")
#: `env`'s options: `-u NAME` / `-C DIR` and their long forms take an argument.
_ENV_OPTION = (r"(?:-[uC]\s*\S+|--(?:unset|chdir)(?:=\S+|\s+\S+)"
               r"|-{1,2}[A-Za-z0-9][\w-]*(?:=\S+)?|--?(?=\s|$))")
#: `timeout`'s options: `-k` / `-s` and their long forms take an argument.
_TIMEOUT_OPTION = (r"(?:-[ks]\s*\S+|--(?:kill-after|signal)(?:=\S+|\s+\S+)"
                   r"|-{1,2}[A-Za-z][\w-]*(?:=\S+)?)")
#: A wrapper before a command: `VAR=value`, `env [options]`, `timeout [options] <n>`,
#: `nice [-n N]`, `time [-p]`, `command [-p]` and the reserved words `!`, `{`, `if`,
#: `then`, `else`, `elif`, `while`, `until`, `do` (CR-MDB-066 §S1).
_WRAPPER = re.compile(
    r"(?:[A-Za-z_][A-Za-z0-9_]*=(?:\"[^\"]*\"|'[^']*'|\S*)|env(?:\s+" + _ENV_OPTION + r")*"
    r"|timeout(?:\s+" + _TIMEOUT_OPTION + r")*\s+\S+"
    r"|nice(?:\s+(?:-n\s*\S+|--adjustment(?:=\S+|\s+\S+)|-\d+))?|time(?:\s+-p)?"
    r"|command(?:\s+-p)?|[!{]|if|then|else|elif|while|until|do)(?:\s+|$)")

REASON = """⛔ BLOCKED: a direct `cargo test` / `cargo nextest` / `cargo llvm-cov` / `cargo check` / `cargo clippy` run is not allowed in a Rust project.

Run it through Crucible's client instead — it runs the same cargo command AND ingests
the results under your agent id. The client is listed in Crucible's manifest
`~/.crucible/crucible-clients.json`; register first if you have not:
  • Tests of one crate (add --test <bin> / --filter <expr> for a single test):
      python3 ~/.crucible/clients/rust-crucible.py test --crate <crate> --agent <id>
  • Compile-only / RED compile-fail (replaces `cargo check`):
      python3 ~/.crucible/clients/rust-crucible.py check --crate <crate> [--tests] --agent <id>
  • Full coverage regression (pre-merge gate, replaces `cargo llvm-cov`):
      python3 ~/.crucible/clients/rust-crucible.py workspace-regression --agent <id> --all-features

Escape hatch, used only with the orchestrator's approval: prefix the command with
ALLOW_RAW_CARGO=1, e.g. ALLOW_RAW_CARGO=1 cargo nextest run -p <crate>"""


def _skip_heredoc_bodies(text: str, index: int, pending: list) -> int:
    """The offset just past the heredoc bodies `pending` opens, read in order from the line
    at `index`; each ends at the line holding its word (leading tabs stripped for `<<-`)."""
    for word, strip_tabs in pending:
        while index < len(text):
            newline = text.find("\n", index)
            end = len(text) if newline < 0 else newline
            line = text[index:end]
            index = end + 1
            if (line.lstrip("\t") if strip_tabs else line) == word:
                break
    return min(index, len(text))


def _segments(text: str):
    """Each command segment of `text` as `(start, end)`, or `None` when a quote is never
    closed (the command does not tokenise). A segment starts at a command position — the
    text's start, a line start, or after a separator — and runs to the next one. Quotes, a
    `#` comment and a backslash escape hide what they hold; a heredoc body is skipped whole,
    and a here-string (`<<<`) opens none."""
    segments, start, quote, pending = [], 0, None, []
    index = 0
    while index < len(text):
        char = text[index]
        if quote:
            if char == "\\" and quote == '"':
                index += 2
                continue
            quote = None if char == quote else quote
            index += 1
            continue
        if char == "\\":
            index += 2
            continue
        if char in "'\"":
            quote = char
            index += 1
            continue
        if char == "`":
            close = index + 1
            while close < len(text) and text[close] != "`":
                close += 2 if text[close] == "\\" else 1
            if close >= len(text):
                quote = char  # an unclosed backquote reads as an unclosed quote
                break
            inner = _segments(text[index + 1:close])
            if inner is None:
                return None
            segments.extend((index + 1 + begin, index + 1 + end) for begin, end in inner)
            index = close + 1
            continue
        if char == "#" and (index == 0 or text[index - 1] in " \t\n;&|("):
            newline = text.find("\n", index)
            index = len(text) if newline < 0 else newline
            continue
        if char == "\n":
            segments.append((start, index))
            index = _skip_heredoc_bodies(text, index + 1, pending)
            start, pending = index, []
            continue
        if text.startswith("$((", index) or text.startswith("((", index):
            index, depth = text.index("((", index) + 2, 2
            while index < len(text) and depth:
                depth += {"(": 1, ")": -1}.get(text[index], 0)
                index += 1
            continue
        if text.startswith("<<<", index):
            index += 3  # a here-string, not a heredoc: it opens no body
            continue
        heredoc = _HEREDOC.match(text, index)
        if heredoc:
            word = next(g for g in heredoc.groups()[1:] if g is not None)
            pending.append((word, bool(heredoc.group(1))))
            index = heredoc.end()
            continue
        separator = _SEPARATOR.match(text, index)
        if separator:
            segments.append((start, index))
            index = start = separator.end()
            continue
        index += 1
    if quote:
        return None
    segments.append((start, len(text)))
    return sorted(segments)


def _commands(text: str):
    """The text of each command at a command position in `text`, wrappers stepped over."""
    for begin, end in _segments(text) or ():
        segment = text[begin:end].lstrip()
        while True:
            wrapper = _WRAPPER.match(segment)
            if not wrapper or not wrapper.group(0):
                break
            segment = segment[wrapper.end():]
        yield segment


def _shell_words(segment: str) -> list:
    """`segment`'s words as the shell passes them to the command: quotes removed, a `#`
    comment dropped, a redirection (`>file`, `2>&1`, `>|`, `&>`) and its target no part of
    them, and a `)` closing a subshell ending them. An unclosed quote reads plain words."""
    lex = shlex.shlex(segment, posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    words, skip_target = [], False
    try:
        for word in lex:
            if word.startswith(")"):
                break
            if skip_target:
                skip_target = False
                continue
            if word and set(word) <= set("<>&|"):
                skip_target = True
                if words and words[-1].isdigit():
                    words.pop()  # the file descriptor of `2>` is the redirection's
                continue
            words.append(word)
    except ValueError:
        return segment.split()
    return words


def _normal(segment: str) -> str:
    """`segment` as the words the shell passes (`_shell_words`), joined by one space."""
    return " ".join(_shell_words(segment))


def _is_cargo_invocation(command: str) -> bool:
    """True when `cargo` with a test-running verb is the command word at a command position,
    read in the words the shell passes it."""
    return any(CARGO_RUN.match(_normal(segment)) for segment in _commands(command))


def _has_marker(directory: str, listing) -> bool:
    """A file named in `MARKERS` in `directory`: read from its `listing`, or by name when it
    cannot be listed (`listing` is `None`). A file is what `os.path.isfile` accepts
    (CR-MDB-066 §S4)."""
    if listing is None:
        return any(os.path.isfile(os.path.join(directory, marker)) for marker in MARKERS)
    return any(name in MARKERS and os.path.isfile(path) for name, path, _ in listing)


def _listing(directory: str, memo: dict):
    """`directory`'s entries as sorted `(name, path, is_dir)` tuples (`is_dir` follows no
    symlink), listed once per run with `os.scandir` and kept in `memo`; `None` when it cannot
    be listed (CR-MDB-066 §S4.1)."""
    if directory not in memo:
        try:
            with os.scandir(directory) as entries:
                memo[directory] = sorted((entry.name, entry.path,
                                          entry.is_dir(follow_symlinks=False))
                                         for entry in entries)
        except OSError:
            memo[directory] = None  # cannot be listed -> checked by name, not descended
    return memo[directory]


def _has_git(directory: str, listing) -> bool:
    """Any `.git` entry in `directory`: read from its `listing`, or by name when it cannot be
    listed (CR-MDB-066 §S4.2)."""
    if listing is None:
        return os.path.lexists(os.path.join(directory, ".git"))
    return any(name == ".git" for name, _, _ in listing)


def _marker_below(root: str, depth: int, memo: dict) -> bool:
    """A marker in a directory at most `depth` levels below `root`: no symlink followed, hidden
    and `SKIPPED_DIRS` directories never entered, a directory that cannot be listed checked by
    name and not descended; each directory listed once, the deepest only for its markers."""
    listing = _listing(root, memo)
    if depth <= 0 or listing is None:
        return False
    for name, path, is_dir in listing:
        if not is_dir or name.startswith(".") or name in SKIPPED_DIRS:
            continue
        if _has_marker(path, _listing(path, memo)):
            return True
        if _marker_below(path, depth - 1, memo):
            return True
    return False


def _in_project(cwd: str) -> bool:
    """CR-MDB-062 §S3: a marker in `cwd`, in a parent up to and including the git root, or
    at most `WALK_DEPTH` levels below that git root. No git root: `cwd` and its parents.
    CR-MDB-066 §S4: one listing per directory per run, shared by the parents and the walk."""
    if not cwd:
        return False
    memo: dict = {}
    try:
        directory = Path(cwd)
        for candidate in (directory, *directory.parents):
            path = str(candidate)
            listing = _listing(path, memo)
            if _has_marker(path, listing):
                return True
            if _has_git(path, listing):
                return _marker_below(path, WALK_DEPTH, memo)
    except (OSError, ValueError):
        return False  # any filesystem error -> allow (a closed hook must never raise)
    return False


def _block(reason: str) -> int:
    print(json.dumps({"decision": "block", "reason": reason}))
    return 2


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except (ValueError, OSError, RecursionError):
        # unreadable payload (bad JSON or UTF-8, a number past the digit limit, nesting past
        # the recursion limit) -> fail open (deterrent, not security boundary)
        return 0
    if not isinstance(payload, dict) or payload.get("tool_name") != "bash":  # neutral shell class (schema.md)
        return 0
    tool_input = payload.get("tool_input") or {}
    if not isinstance(tool_input, dict):
        return 0
    command = tool_input.get("command") or ""
    cwd = payload.get("cwd") or ""
    if not isinstance(command, str) or not isinstance(cwd, str) or not command:
        return 0

    # Escape hatch — explicit opt-out wins before any matching.
    if re.search(r"ALLOW_RAW_CARGO=(1|true)", command):
        return 0
    # Cheap pre-filter: most commands never mention cargo.
    if "cargo" not in command:
        return 0

    if not _is_cargo_invocation(command):
        return 0
    if not _in_project(cwd):
        return 0
    return _block(REASON)


if __name__ == "__main__":
    sys.exit(main())
