#!/usr/bin/env python3
"""session-start protocol script — surfaces the Crucible board (open plans,
active cycle, lastRunCr) into session context as ambient status (CR-MDB-015
§S3, per the #1334 division; AXI principle 7).

NEW in hooks-src (not an import): authored against
crucible:clients/STATUS-CONTRACT.md **VERSION 1.0.0** (CR-CRU-035). The
status feed is the project stack client's `status` verb — a read-only,
hook-safe board query that always exits 0 and reports one of THREE definitive
terminal states, each rendered DISTINCTLY here:

  1. board present   -> plan rows (cr / wave / status / activeCycleId) +
                        lastRunCr;
  2. no plan filed   -> `ok:true`, empty plans, `warnings:[]` — a DEFINITIVE
                        "no plan filed" note (never blurred with an outage);
  3. tolerant degrade-> same empty shape but `warnings[]` carries
                        `{code:"status-unavailable"}` — rendered as a board-
                        unavailable degradation note (never "no plan").

A fourth, hook-local defense-in-depth case — the feed command itself is
missing/broken/hanging — ALSO degrades to exit 0 fast.

Feed resolution: $MODELB_STATUS_CMD (the COMPLETE feed command, shell-split —
the dependency-injection override) wins; otherwise the hook reads Crucible's
own released-client manifest `~/.crucible/crucible-clients.json` (written by
Crucible's installer; the same file pre-flight judges Crucible by,
CR-MDB-036), finds the project's stack from the nearest stack marker walking
up from the cwd, and runs `clients[<key>] status` (CR-MDB-018 §S1). The
earlier `[install].clients_dir` lookup in `$MODELB_HOME/install.toml` is
retired: nothing wrote that key, and a copy would go stale. Every unresolved
case (manifest absent, unparsable, without a `clients` object, without the
stack's key, or naming a missing file; or no stack marker) is a degrade
note; no other location is ever tried (§S2). This is a SessionStart hook: it
NEVER blocks, NEVER exits non-zero, and every subprocess is timeout-bounded.
Self-contained, stdlib only (deployed standalone, so it carries its own
marker -> manifest-key table, kept in parity with pre-flight's
`STACK_CLIENT_KEYS` by test, §S3); zero workflow-cycle env coupling.
"""

import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

STATUS_CONTRACT_VERSION = "1.0.0"

#: Bound on the feed subprocess — a session start must never hang.
_FEED_TIMEOUT_SECONDS = 2.0

#: Crucible's released-client manifest, relative to the user's home.
_MANIFEST_RELPATH = Path(".crucible") / "crucible-clients.json"
_MANIFEST_DISPLAY = "~/.crucible/crucible-clients.json"

#: Ordered (marker_filename, stack, manifest_key): the stack as spelled in
#: pre-flight's STACK_CLIENT_KEYS and the manifest `clients` key it maps to
#: (parity enforced by test, CR-MDB-018 §S3). Tried in order at each
#: directory walking up from the cwd; the nearest marker wins.
_STACK_MARKERS = (
    ("Cargo.toml", "rust", "rust"),
    ("pom.xml", "quarkus", "mvn"),
    ("bun.lock", "bun", "bun"),
    ("bun.lockb", "bun", "bun"),
    ("pyproject.toml", "python", "python"),
)


class _Unresolved(Exception):
    """The feed could not be resolved; the message is the degrade note."""


def _find_stack() -> tuple[str, str] | None:
    """(stack, manifest_key) for the nearest marker walking up from the cwd,
    or None when no marker is found (no stack is ever guessed)."""
    directory = Path.cwd()
    for candidate in (directory, *directory.parents):
        for marker, stack, key in _STACK_MARKERS:
            if (candidate / marker).is_file():
                return stack, key
    return None


def _manifest_note(problem: str) -> str:
    """A manifest-related degrade note: names the manifest and the fix."""
    return (f"Crucible's client manifest {_MANIFEST_DISPLAY} {problem}; "
            "re-run Crucible's own installer to (re)write it, or set "
            "MODELB_STATUS_CMD")


def _discover_feed_argv() -> list[str]:
    """Manifest discovery: the cwd's nearest stack marker picks a `clients`
    key of Crucible's manifest, and that client is run with `status`.
    Raises `_Unresolved` (rendered as a degrade note, never an error) when
    either half fails; no substitute location is ever tried."""
    found = _find_stack()
    if found is None:
        raise _Unresolved(
            "no stack marker found walking up from the working directory, so "
            "no Crucible client applies (set MODELB_STATUS_CMD to override)"
        )
    stack, key = found
    manifest = Path.home() / _MANIFEST_RELPATH
    if not manifest.is_file():
        raise _Unresolved(_manifest_note("is absent"))
    try:
        body = json.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise _Unresolved(_manifest_note(f"is unreadable ({exc})")) from exc
    clients = body.get("clients") if isinstance(body, dict) else None
    if not isinstance(clients, dict):
        raise _Unresolved(_manifest_note("has no `clients` object"))
    client = clients.get(key)
    if not isinstance(client, str) or not client:
        raise _Unresolved(_manifest_note(
            f"has no {key!r} client for the {stack} stack"))
    client_path = Path(client)
    if not client_path.is_file():
        raise _Unresolved(_manifest_note(
            f"names a missing {key!r} client ({client_path})"))
    return [sys.executable, str(client_path), "status"]


def _parse_envelope(text: str) -> dict:
    """Minimal TOON-AXI reader for the STATUS-CONTRACT 1.0.0 `status`
    envelope: plans table rows, lastRunCr, count, warnings codes."""
    plans: list[dict] = []
    warnings: list[dict] = []
    last_run_cr = None
    count = None
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        stripped = lines[i].strip()
        table = re.match(r"(plans|warnings)\[(\d+)\]\{([^}]*)\}:", stripped)
        if table:
            key, rows, fields = table.group(1), int(table.group(2)), table.group(3).split(",")
            for j in range(1, rows + 1):
                if i + j >= len(lines):
                    break
                cells = lines[i + j].strip().split(",", len(fields) - 1)
                row = dict(zip(fields, cells))
                (plans if key == "plans" else warnings).append(row)
            i += rows + 1
            continue
        scalar = re.match(r"lastRunCr:\s*(.*)$", stripped)
        if scalar:
            value = scalar.group(1).strip()
            last_run_cr = None if value in ("", "null") else value
        scalar = re.match(r"count:\s*(\d+)$", stripped)
        if scalar:
            count = int(scalar.group(1))
        i += 1
    return {"plans": plans, "warnings": warnings, "lastRunCr": last_run_cr, "count": count}


def _degrade(note: str) -> int:
    """Render a degradation note and continue — a session start never blocks."""
    print(f"Crucible board (ambient status): degraded — {note}. "
          "Continuing without ambient board status.")
    return 0


def main() -> int:
    # Drain the SessionStart stdin payload (unused; keeps the pipe clean).
    try:
        sys.stdin.read()
    except OSError:
        pass  # a closed/absent stdin is fine for an ambient hook

    override = os.environ.get("MODELB_STATUS_CMD", "")
    if override:
        try:
            argv = shlex.split(override)
        except ValueError:
            return _degrade(f"MODELB_STATUS_CMD is unparsable: {override!r}")
        if not argv:
            return _degrade("MODELB_STATUS_CMD is empty")
    else:
        try:
            argv = _discover_feed_argv()
        except _Unresolved as exc:
            return _degrade(str(exc))

    try:
        result = subprocess.run(
            argv, capture_output=True, text=True, timeout=_FEED_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return _degrade(f"status feed could not be run ({exc})")
    if result.returncode != 0:
        # Contract 1.0.0: a real feed never exits non-zero -> broken feed.
        return _degrade(f"status feed exited {result.returncode}")

    envelope = _parse_envelope(result.stdout)
    if any(w.get("code") == "status-unavailable" for w in envelope["warnings"]):
        detail = next(
            (w.get("detail", "") for w in envelope["warnings"]
             if w.get("code") == "status-unavailable"),
            "",
        )
        print(f"Crucible board: status-unavailable (tolerant degrade) — {detail}. "
              "The board could not be read; continuing without ambient status.")
        return 0
    if envelope["plans"]:
        print(f"Crucible board ({len(envelope['plans'])} open plan(s)):")
        for row in envelope["plans"]:
            print(
                f"  cr={row.get('cr')} wave={row.get('wave')} "
                f"status={row.get('status')} activeCycleId={row.get('activeCycleId')}"
            )
        if envelope["lastRunCr"]:
            print(f"lastRunCr: {envelope['lastRunCr']}")
        return 0
    if envelope["count"] == 0:
        print("Crucible board: no plan filed (an empty board is definitive). "
              "Next: plan-file --cr <CR-ID> --wave <n>.")
        return 0
    return _degrade("status feed output did not match STATUS-CONTRACT "
                    f"{STATUS_CONTRACT_VERSION}")


if __name__ == "__main__":
    sys.exit(main())
