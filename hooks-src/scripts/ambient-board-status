#!/usr/bin/env python3
"""session-start protocol script — surfaces the Crucible board (open plans,
active cycle, last closed CR) into session context as ambient status
(CR-MDB-015 §S3, per the #1334 division; AXI principle 7).

NEW in hooks-src (not an import): authored against Crucible's `status`
envelope contract document, `~/.crucible/clients/STATUS-CONTRACT.md`,
document version 2.0.0 (CR-MDB-019 §S1). That number is the version of the
contract document itself, not a Crucible product release (Crucible's own
releases are 0.x); `STATUS_CONTRACT_VERSION` pins it so a degrade note names
the contract in force. The status feed is the project stack client's
`status` verb — a read-only, hook-safe board query that always exits 0 and
reports one of THREE definitive terminal states, each rendered DISTINCTLY
here:

  1. board present   -> the OPEN plan rows only (cr / wave / status /
                        activeCycleId; closed rows are neither listed nor
                        counted, CR-MDB-019 §S3) + `last closed: <id>` from
                        lastClosedCr (§S2); a board whose rows are all
                        closed prints a definitive "no open plan" note;
  2. no plan filed   -> `ok:true`, empty plans, `warnings:[]` — a DEFINITIVE
                        "no plan filed" note (never blurred with an outage);
  3. tolerant degrade-> same empty shape but `warnings[]` carries
                        `{code:"status-unavailable"}` — rendered as a board-
                        unavailable degradation note (never "no plan").

Table cells the TOON encoder quoted (e.g. `"1"`) are rendered unquoted (§S4).

A fourth, hook-local defense-in-depth case — the feed command itself is
missing/broken/hanging — ALSO degrades to exit 0 fast.

Feed resolution: $MODELB_STATUS_CMD (the COMPLETE feed command, shell-split —
the dependency-injection override) wins; otherwise the hook reads Crucible's
own released-client manifest `~/.crucible/crucible-clients.json` (written by
Crucible's installer; the same file pre-flight judges Crucible by,
CR-MDB-036), finds the project's stack from the nearest stack marker walking
up from the cwd, and runs `clients[<key>] status` (CR-MDB-018 §S1). A
marker may be a `{dir}` template naming the directory being checked: an
arduino-cli sketch is `<dir>/<dir>.ino` (CR-MDB-019 §S5). The
earlier `[install].clients_dir` lookup in `$MODELB_HOME/install.toml` is
retired: nothing wrote that key, and a copy would go stale. Every unresolved
case (manifest absent or not a readable file, unparsable, without a
`clients` object, without the stack's key, or naming a missing/unreadable
client; or no stack marker, or an unavailable cwd) is a degrade
note; no other location is ever tried (§S2). This is a SessionStart hook: it
NEVER blocks, NEVER exits non-zero, and every subprocess is timeout-bounded.
Self-contained, stdlib only (deployed standalone, so it carries its own
marker -> manifest-key table, kept in parity with pre-flight's
`STACK_CLIENT_KEYS` by test, §S3); zero workflow-cycle env coupling.
"""

import json
import os
import re
import shlex
import stat
import subprocess
import sys
from pathlib import Path

STATUS_CONTRACT_VERSION = "2.0.0"

#: Bound on the feed subprocess — a session start must never hang.
_FEED_TIMEOUT_SECONDS = 2.0

#: Crucible's released-client manifest, relative to the user's home.
_MANIFEST_RELPATH = Path(".crucible") / "crucible-clients.json"
_MANIFEST_DISPLAY = "~/.crucible/crucible-clients.json"

#: Ordered (marker_filename, stack, manifest_key): the stack as spelled in
#: pre-flight's STACK_CLIENT_KEYS and the manifest `clients` key it maps to
#: (parity enforced by test, CR-MDB-018 §S3). Tried in order at each
#: directory walking up from the cwd; the nearest marker wins. A marker
#: containing `{dir}` is a template: `{dir}` is replaced by the name of the
#: directory being checked (the arduino-cli sketch rule, CR-MDB-019 §S5).
_STACK_MARKERS = (
    ("Cargo.toml", "rust", "rust"),
    ("pom.xml", "quarkus", "mvn"),
    ("bun.lock", "bun", "bun"),
    ("bun.lockb", "bun", "bun"),
    ("pyproject.toml", "python", "python"),
    ("{dir}.ino", "arduino", "arduino"),
)

#: A surrogate or a C0/DEL/C1 control character: never rendered from a
#: decoded cell (a lone surrogate cannot be printed; ESC would reach the
#: session context as a terminal escape).
_UNSAFE_CHARS = re.compile(r"[\x00-\x1f\x7f-\x9f\ud800-\udfff]")


class _Unresolved(Exception):
    """The feed could not be resolved; the message is the degrade note."""


def _find_stack() -> tuple[str, str] | None:
    """(stack, manifest_key) for the nearest marker walking up from the cwd,
    or None when no marker is found (no stack is ever guessed). A cwd that
    cannot be read (e.g. deleted under the session) is a degrade note."""
    try:
        directory = Path.cwd()
    except OSError as exc:
        raise _Unresolved(
            f"the working directory is unavailable ({exc}), so no stack "
            "marker can be found and no Crucible client applies (set "
            "MODELB_STATUS_CMD to override)") from exc
    for candidate in (directory, *directory.parents):
        for marker, stack, key in _STACK_MARKERS:
            if "{dir}" in marker:
                if not candidate.name:
                    continue  # the filesystem root names no sketch
                marker = marker.replace("{dir}", candidate.name)
            # os.path.isfile swallows every OSError on every Python version
            # (Path.is_file raises e.g. PermissionError on 3.11/3.12).
            if os.path.isfile(candidate / marker):
                return stack, key
    return None


def _file_problem(path: Path) -> str | None:
    """None when ``path`` is a regular file; otherwise "absent" (genuinely
    not found) or "unreadable" (exists but is not a readable regular file:
    a directory, an unreadable parent, ...). Never raises."""
    try:
        mode = os.stat(path).st_mode
    except (FileNotFoundError, NotADirectoryError):
        return "absent"
    except (OSError, ValueError):
        return "unreadable"
    return None if stat.S_ISREG(mode) else "unreadable"


def _manifest_note(problem: str) -> str:
    """A manifest-related degrade note: names the manifest and the fix."""
    return (f"Crucible's client manifest {_MANIFEST_DISPLAY} {problem}; "
            "re-run Crucible's own installer to (re)write it, or set "
            "MODELB_STATUS_CMD")


def _discover_feed_argv() -> list[str]:
    """Manifest discovery: the cwd's nearest stack marker picks a `clients`
    key of Crucible's manifest, and that client is run with `status`.
    Raises `_Unresolved` (rendered as a degrade note, never an error) when
    either half fails; no substitute location is ever tried."""
    found = _find_stack()
    if found is None:
        raise _Unresolved(
            "no stack marker found walking up from the working directory, so "
            "no Crucible client applies (set MODELB_STATUS_CMD to override)"
        )
    stack, key = found
    manifest = Path.home() / _MANIFEST_RELPATH
    problem = _file_problem(manifest)
    if problem == "absent":
        raise _Unresolved(_manifest_note("is absent"))
    if problem is not None:
        raise _Unresolved(_manifest_note("is not a readable file"))
    try:
        body = json.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise _Unresolved(_manifest_note(f"is unreadable ({exc})")) from exc
    clients = body.get("clients") if isinstance(body, dict) else None
    if not isinstance(clients, dict):
        raise _Unresolved(_manifest_note("has no `clients` object"))
    client = clients.get(key)
    if not isinstance(client, str) or not client:
        raise _Unresolved(_manifest_note(
            f"has no {key!r} client for the {stack} stack"))
    client_path = Path(client).expanduser()
    problem = _file_problem(client_path)
    if problem == "absent":
        raise _Unresolved(_manifest_note(
            f"names a missing {key!r} client ({client_path})"))
    if problem is not None:
        raise _Unresolved(_manifest_note(
            f"names a {key!r} client that is not a readable file "
            f"({client_path})"))
    return [sys.executable, str(client_path), "status"]


def _unquote(cell: str) -> str:
    """A cell the TOON encoder JSON-quoted (e.g. `"1"`) rendered without its
    quotes (CR-MDB-019 §S4); any other cell is returned unchanged. A decoded
    value carrying a surrogate or a control character (e.g. an escaped ESC)
    is rejected: the raw inner text is used instead, itself stripped of
    control characters, so nothing unprintable reaches the session."""
    if len(cell) >= 2 and cell.startswith('"') and cell.endswith('"'):
        try:
            value = json.loads(cell)
        except json.JSONDecodeError:
            value = None
        if not isinstance(value, str) or _UNSAFE_CHARS.search(value):
            return _UNSAFE_CHARS.sub("", cell[1:-1])
        return value
    return cell


def _parse_envelope(text: str) -> dict:
    """Minimal TOON-AXI reader for the status envelope contract document
    2.0.0 `status` envelope: plans table rows, lastClosedCr, count,
    warnings codes. Quoted cells are unquoted."""
    plans: list[dict] = []
    warnings: list[dict] = []
    last_closed_cr = None
    count = None
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        stripped = lines[i].strip()
        table = re.match(r"(plans|warnings)\[(\d+)\]\{([^}]*)\}:", stripped)
        if table:
            key, rows, fields = table.group(1), int(table.group(2)), table.group(3).split(",")
            header_indent = len(lines[i]) - len(lines[i].lstrip())
            consumed = 0
            for j in range(1, rows + 1):
                if i + j >= len(lines):
                    break
                line = lines[i + j]
                # A row sits deeper than its header; a table declaring more
                # rows than it carries must not swallow the next scalars.
                if not line.strip() or len(line) - len(line.lstrip()) <= header_indent:
                    break
                cells = [_unquote(c.strip()) for c in
                         line.strip().split(",", len(fields) - 1)]
                row = dict(zip(fields, cells))
                (plans if key == "plans" else warnings).append(row)
                consumed = j
            i += consumed + 1
            continue
        scalar = re.match(r"lastClosedCr:\s*(.*)$", stripped)
        if scalar:
            value = _unquote(scalar.group(1).strip())
            last_closed_cr = None if value in ("", "null") else value
        scalar = re.match(r"count:\s*(\d+)$", stripped)
        if scalar:
            count = int(scalar.group(1))
        i += 1
    return {"plans": plans, "warnings": warnings,
            "lastClosedCr": last_closed_cr, "count": count}


def _degrade(note: str) -> int:
    """Render a degradation note and continue — a session start never blocks."""
    print(f"Crucible board (ambient status): degraded — {note}. "
          "Continuing without ambient board status.")
    return 0


def main() -> int:
    # Printing never raises on an unencodable character (e.g. a surrogate).
    try:
        sys.stdout.reconfigure(errors="backslashreplace")
    except (AttributeError, ValueError, OSError):
        pass  # a non-reconfigurable stdout keeps its own error policy
    # Drain the SessionStart stdin payload (unused; keeps the pipe clean).
    try:
        sys.stdin.read()
    except OSError:
        pass  # a closed/absent stdin is fine for an ambient hook

    override = os.environ.get("MODELB_STATUS_CMD", "")
    if override:
        try:
            argv = shlex.split(override)
        except ValueError:
            return _degrade(f"MODELB_STATUS_CMD is unparsable: {override!r}")
        if not argv:
            return _degrade("MODELB_STATUS_CMD is empty")
    else:
        try:
            argv = _discover_feed_argv()
        except _Unresolved as exc:
            return _degrade(str(exc))

    try:
        result = subprocess.run(
            argv, capture_output=True, text=True, errors="replace",
            timeout=_FEED_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return _degrade(f"status feed could not be run ({exc})")
    if result.returncode != 0:
        # Contract 2.0.0: a real feed never exits non-zero -> broken feed.
        return _degrade(f"status feed exited {result.returncode}")

    envelope = _parse_envelope(result.stdout)
    if any(w.get("code") == "status-unavailable" for w in envelope["warnings"]):
        detail = next(
            (w.get("detail", "") for w in envelope["warnings"]
             if w.get("code") == "status-unavailable"),
            "",
        )
        print(f"Crucible board: status-unavailable (tolerant degrade) — {detail}. "
              "The board could not be read; continuing without ambient status.")
        return 0
    if envelope["plans"]:
        open_rows = [row for row in envelope["plans"]
                     if row.get("status") != "closed"]
        if open_rows:
            print(f"Crucible board ({len(open_rows)} open plan(s)):")
            for row in open_rows:
                print(
                    f"  cr={row.get('cr')} wave={row.get('wave')} "
                    f"status={row.get('status')} activeCycleId={row.get('activeCycleId')}"
                )
        else:
            print("Crucible board: no open plan (every filed plan is closed; "
                  "the board is definitive).")
        if envelope["lastClosedCr"]:
            print(f"last closed: {envelope['lastClosedCr']}")
        return 0
    if envelope["count"] == 0:
        print("Crucible board: no plan filed (an empty board is definitive). "
              "Next: plan-file --cr <CR-ID> --wave <n>.")
        return 0
    return _degrade("status feed output did not match the status envelope "
                    f"contract document {STATUS_CONTRACT_VERSION}")


def _run() -> int:
    """The script entry: a last-resort guard so any unexpected Exception
    degrades to a note and exit 0 — a session start never fails."""
    try:
        return main()
    except Exception as exc:  # noqa: BLE001 — the hook must never fail
        try:
            return _degrade("the ambient hook hit an unexpected error "
                            f"({type(exc).__name__}: {exc})")
        except Exception:  # noqa: BLE001 — even the note may not print
            return 0


if __name__ == "__main__":
    sys.exit(_run())
